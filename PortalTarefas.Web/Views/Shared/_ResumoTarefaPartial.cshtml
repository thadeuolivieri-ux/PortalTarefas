@model PortalTarefas.Web.Models.Tarefa

<div class="mb-3">
    <h5>@Model.Titulo</h5>
    <p>@Model.Descricao</p>
    <p><small>Prioridade: @Model.Prioridade Prazo: @Model.Prazo.ToString("dd/MM/yyyy")</small></p>
    <div>
        <a asp-controller="Tarefas" asp-action="Detalhes" asp-route-id="@Model.Id">Detalhes</a>
        <a asp-controller="Tarefas" asp-action="Editar" asp-route-id="@Model.Id">Editar</a>
    </div>
</div>