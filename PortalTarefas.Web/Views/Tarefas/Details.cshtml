@model PortalTarefas.Web.Models.Tarefa
@{
    ViewData["Title"] = "Detalhes da Tarefa";
}

<h2 class="mb-4">@ViewData["Title"]</h2>

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <strong>Identificador (ID):</strong> #@Model.Id
    </div>
    <div class="card-body">
        <h3 class="card-title text-primary">@Model.Titulo</h3>
        <p class="card-text mt-3"><strong>Descrição:</strong> @Model.Descricao</p>
        <p class="card-text">
            <strong>Prioridade:</strong> 
            <span class="badge bg-@(Model.Prioridade == Prioridade.Alta ? "danger" : Model.Prioridade == Prioridade.Media ? "warning" : "info")">
                @Model.Prioridade
            </span>
        </p>
        <p class="card-text"><strong>Prazo de Conclusão:</strong> @Model.Prazo.ToString("dd/MM/yyyy")</p>
    </div>
    <div class="card-footer d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
        <a asp-action="Index" class="btn btn-secondary">Voltar para a Lista</a>
    </div>
</div>