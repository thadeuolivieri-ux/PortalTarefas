@model PortalTarefas.Web.ViewModels.TarefaInputModel
@{
    ViewData["Title"] = "Editar Tarefa";
}

<h2 class="mb-4">@ViewData["Title"]</h2>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group mb-3">
                <label asp-for="Titulo" class="form-label font-weight-bold"></label>
                <input asp-for="Titulo" class="form-control" />
                <span asp-validation-for="Titulo" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Descricao" class="form-label font-weight-bold"></label>
                <textarea asp-for="Descricao" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Descricao" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Prioridade" class="form-label font-weight-bold"></label>
                <select asp-for="Prioridade" class="form-select" asp-items="Html.GetEnumSelectList<PortalTarefas.Web.Models.Prioridade>()"></select>
                <span asp-validation-for="Prioridade" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Prazo" class="form-label font-weight-bold"></label>
                <input asp-for="Prazo" class="form-control" type="date" />
                <span asp-validation-for="Prazo" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning">Atualizar Tarefa</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>